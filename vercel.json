{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "env -u NPM_CONFIG_CACHE_DIR -u npm_config_cache_dir npm install",
  "buildCommand": "env -u NPM_CONFIG_CACHE_DIR -u npm_config_cache_dir npm run build",
  "redirects": [
    {
      "source": "/(today|welcome|medicines|history|routines|you)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/(dose|medicine|day)/:rest*",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "missing": [
        {
          "type": "host",
          "value": "tend\\.ashwin\\.co\\.in"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(fonts|shots)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
